    {
      "id": "DCM1001",
      "code": "DCM1001",
      "name": "Programa de Intercâmbio I",
      "credits": 0,
      "hours": 0,
      "phase": 12,
      "type": "Op",
      "prerequisites": [],
      "equivalents": [
        "DCS7001"
